# AI Lure Tracker - Environment Configuration
# Copy this file to .env and insert your API keys for enhanced enrichment.
# Free tiers are supported for all integrated platforms.

# Enrichment API Keys
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# Local CTI Platform Integrations
# OpenCTI Integration
OPENCTI_URL=http://localhost:8080
OPENCTI_TOKEN=
OPENCTI_ENABLE=false

# MISP Integration
MISP_URL=https://localhost:8443
MISP_KEY=
MISP_VERIFY_SSL=false
MISP_ENABLE=false

# Execution Options
LOG_LEVEL=INFO
ENVIRONMENT=production
